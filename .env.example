# tabterm config

# server bind
HOST=127.0.0.1
PORT=3007

# workspace
WORKERS_ROOT=C:/workspace
WORKERS_COUNT=8
WORKER_PREFIX=worker-

# general session (created via "+" / "New session") — no ccx env, no telegram plugin
NEW_SESSION_PREFIX=session-
# args for general sessions (default: empty = plain `claude`)
SESSION_CLAUDE_ARGS=

# claude invocation (tabterm spawns this directly; legacy start-ccx.bat no longer needed)
CLAUDE_COMMAND=claude
# Space-separated additional args. Token plugin + dangerous skip are the ccx defaults.
CLAUDE_ARGS=--dangerously-skip-permissions --channels plugin:telegram@claude-plugins-official

# HydraTeams proxy (ccx mode). Set HYDRATEAMS_ENABLED=false to disable proxy/preflight entirely.
HYDRATEAMS_ENABLED=true
ANTHROPIC_BASE_URL=http://localhost:3456
HYDRATEAMS_HEALTH_URL=http://127.0.0.1:3456/health
HYDRATEAMS_LAUNCHER=C:/Tools/HydraTeams/hydra-launcher.sh
HYDRATEAMS_BASH=C:/Program Files/Git/bin/bash.exe
HYDRATEAMS_HEALTH_TIMEOUT_MS=2000
HYDRATEAMS_POLL_MS=1000
HYDRATEAMS_POLL_MAX=10

# session
RING_BUFFER_BYTES=2097152
PTY_DEFAULT_COLS=120
PTY_DEFAULT_ROWS=32

# auth
# AUTH_FILE=data/auth.json
SESSION_TTL_HOURS=168

# cookie
COOKIE_NAME=tabterm.sid
# set true ONLY when serving via HTTPS (e.g. behind tailscale serve)
# WARNING: if you connect directly to http://127.0.0.1:PORT with COOKIE_SECURE=true,
# the browser will NOT store the login cookie and you cannot log in.
# For local-only direct HTTP testing, set COOKIE_SECURE=false.
COOKIE_SECURE=true

# Public origin (set when Tailscale Serve / nginx fronts this server with a different host)
# Example: PUBLIC_ORIGIN=https://myhost.tail-scale.ts.net
# PUBLIC_ORIGIN=

# CSRF requires this header on POST/DELETE
CSRF_HEADER=x-tabterm-csrf

# rate-limit
LOGIN_RATE_PER_MIN=5
LOGIN_LOCKOUT_MINUTES=15

# logging
AUDIT_FILE=data/audit.log
